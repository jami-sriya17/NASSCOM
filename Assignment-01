    {
      "cell_type": "code",
      "source": [
        "def pairsum(a, target):\n",
        "    for i in range(len(a)):\n",
        "        for j in range(i + 1, len(a)):\n",
        "            if a[i] + a[j] == target:\n",
        "                print(a[i], a[j])"
