        "1.Remove duplicates and find second largest element in a list without using sort()"
      ],
      "metadata": {
        "id": "XMtEvodVF2sS"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def remove_duplicates(lst):\n",
        "    return list(set(lst))\n",
        "def second_largest(lst):\n",
        "    lst = remove_duplicates(lst)\n",
        "    largest = max(lst)\n",
        "    second_largest = min(lst)\n",
        "    for i in lst:\n",
        "        if i > second_largest and i < largest:\n",
        "            second_largest = i\n",
        "    return lst[-2]"
      ],
      "metadata": {
