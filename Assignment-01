        "##6. Longest Consecutive Sequence\n",
        "Given an unsorted list, find the length of the longest consecutive sequence.\n",
        "Example: [100,4,200,1,3,2] -> 4\n"
      ],
      "metadata": {
        "id": "7PJ3vPUFOAD_"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def consecutive(a):\n",
        "    s = set(a)\n",
        "    longest = 0\n",
        "    for i in s:\n",
        "        if i - 1 not in s:\n",
        "            count = 1\n",
        "            while i + count in s:\n",
        "                count += 1\n",
        "            if count > longest:\n",
        "                longest = count\n",
        "    print(longest)\n"
      ],
