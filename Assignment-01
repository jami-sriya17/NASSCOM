        "4.Given a list of integers and a target value,find all pairs whose sum  equal to target"
      ],
      "metadata": {
        "id": "1htPgEtOAidU"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def find_pairs(lst, target):\n",
        "    seen =[]\n",
        "    pair = []\n",
        "    for num in lst:\n",
        "        complement = target - num\n",
        "        if complement in seen:\n",
        "            pair.append((num,complement))\n",
        "        seen.append(num)\n",
        "    return pair"
      ],
      "metadata": {
