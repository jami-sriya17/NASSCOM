        "##8. Spiral Traversal\n",
        "Given an N×N matrix stored as nested lists, print the elements in spiral order.\n"
      ],
      "metadata": {
        "id": "WfIfqsRHOQP3"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def spiral(lst):\n",
        "    top, bottom = 0, len(lst)-1\n",
        "    left, right = 0, len(lst[0])-1\n",
        "\n",
        "    while top <= bottom and left <= right:\n",
        "        for i in range(left, right+1):\n",
        "            print(lst[top][i], end=\" \")\n",
        "        top += 1\n",
        "\n",
        "        for i in range(top, bottom+1):\n",
        "            print(lst[i][right], end=\" \")\n",
        "        right -= 1\n",
        "\n",
        "        for i in range(right, left-1, -1):\n",
        "            print(lst[bottom][i], end=\" \")\n",
        "        bottom -= 1\n",
        "\n",
        "        for i in range(bottom, top-1, -1):\n",
        "            print(lst[i][left], end=\" \")\n",
        "        left += 1"
      ],
      "metadata": {
        "id": "X1wgXZnAQnU1"
